@model Product
<section class="editor-section">
    <div class="container editor-shell">
        <a class="back-link" asp-action="Index">← КАТАЛОГҚА ҚАЙТУ</a>
        <div class="editor-heading"><p class="kicker">OBJECT / ЖАҢА ЖАЗБА</p><h1>Өнімді <em>қосу.</em></h1><p>Өнім ақпаратын енгізіп, өз суретіңізді URL арқылы қосыңыз немесе файл ретінде жүктеңіз.</p></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="product-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
            <div class="form-section-title"><span>01</span><b>НЕГІЗГІ АҚПАРАТ</b></div>
            <div class="row g-3">
                <div class="col-md-7"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="Мысалы: Cobalt One" autocomplete="off" /><span asp-validation-for="Name" class="field-error"></span></div>
                <div class="col-md-5"><label asp-for="Price" class="form-label"></label><div class="input-group"><input asp-for="Price" class="form-control" type="number" min="1" step="1" placeholder="429000" /><span class="input-group-text">₸</span></div><span asp-validation-for="Price" class="field-error"></span></div>
                <div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" asp-items="ViewBag.Categories" class="form-select" required><option value="">Санатты таңдаңыз</option></select><span asp-validation-for="Category" class="field-error"></span></div>
                <div class="col-md-6"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" placeholder="Өнімді қысқаша сипаттаңыз" /><span asp-validation-for="Description" class="field-error"></span></div>
            </div>

            <div class="form-section-title photo-section-title"><span>02</span><b>ӨЗ СУРЕТІҢІЗ</b><small>Суретті сілтемемен енгізіңіз немесе құрылғыңыздан жүктеңіз.</small></div>
            <div class="url-photo-box">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://example.com/product-photo.jpg" autocomplete="url" />
                <span asp-validation-for="ImageUrl" class="field-error"></span>
                <div class="url-photo-preview" id="urlPhotoPreview" hidden><img id="urlPhotoPreviewImage" alt="Сілтемедегі өнім фотосының алдын ала көрінісі" /><span>СІЛТЕМЕ ФОТОСЫ</span></div>
                <small class="form-hint">Жалпыға ашық HTTPS сурет сілтемесін қойыңыз. URL және файл бірге берілсе, жүктелген файл қолданылады.</small>
            </div>

            <div class="upload-box"><label for="photoFile" class="form-label">ӨЗ ФАЙЛЫҢЫЗДЫ ЖҮКТЕУ <span>(JPG, PNG, WEBP · 5 MB дейін)</span></label><input id="photoFile" name="photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control upload-input" /><span class="field-error">@Html.ValidationMessage("photo")</span></div>

            <div class="availability-box"><label class="available-check"><input asp-for="IsAvailable" /><span class="check-visual"></span><span>Қазір қоймада бар</span></label><span class="availability-help">Қолжетімділік өнім карточкасында белгіленеді.</span></div>
            <div class="form-actions"><button type="submit" class="submit-product">Өнімді қосу <span>↗</span></button><a asp-action="Index" class="cancel-link">БАС ТАРТУ</a></div>
        </form>
    </div>
</section>
